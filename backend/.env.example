# FinTech API Environment Variables
# Copy this file to .env and fill in your actual values before deploying.

# ── FRED API (Federal Reserve Economic Data) ──────────────────────────────────
# Free key — register at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── AWS Credentials for Lambda invocation ────────────────────────────────────
# IAM user needs: lambda:InvokeFunction on the three fintech-* functions
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-south-1

# ── Lambda Function Names (must match names in template.yaml) ─────────────────
LAMBDA_MONTE_CARLO=fintech-monte-carlo
LAMBDA_OPTIMIZER=fintech-optimizer
LAMBDA_CAPITAL_SOLVER=fintech-capital-solver

# ── CORS — comma-separated list of allowed origins ───────────────────────────
# Use * for development. Set your exact frontend domain in production.
# Example: CORS_ORIGINS=https://yourapp.vercel.app,https://yourdomain.com
CORS_ORIGINS=*
